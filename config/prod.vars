%% Overrides layered on top of default.vars for the `prod` profile only.
%%
%% relx renders config/ssb.cfg from the overlay_vars list in order, so this
%% file needs to carry ONLY what differs — everything else (store locations,
%% room, blob_scan, require_valid_sigs) still comes from default.vars.
%%
%% The point of the split is safety, and it only works in this direction:
%% ?DEFAULT_NETWORK_ID and default.vars hold the almost-mainnet id used for
%% development and testing, so `make rel`, `make devpkg`, eunit and CT can
%% never reach the real network by accident.  Joining it has to be a
%% deliberate act, and building the prod profile is that act.
{network_id, "1KHLiKZvAvjbY1ziZEHMXawbCEIM6qwjCDm3VYRan\/s="}.

%% The data lives in the running account's home, outside the release, so
%% an upgrade (extracting a new tarball) cannot touch it.  On a pub the
%% service account's HOME is /var/lib/erlbutt.  An install that already
%% keeps its data in <release>/.ssberl goes on using it, with a warning.
{data_dir, "~/.ssberl"}.

%% A released node dials out.  Off, it accepts connections but never opens
%% one, so a fresh install sits silent with nothing in the log to say why.
%% Development builds keep it off (default.vars): a dev or test node makes
%% only the connections you make for it.  To run a prod node inbound-only
%% — a pub, or a conversion before it is verified — put
%% {peer_dialer, false}. in <data>/ssb.cfg, or call admin.dialer.disable,
%% which persists in overrides.cfg.
{peer_dialer, true}.
