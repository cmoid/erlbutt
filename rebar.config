{require_otp_vsn, "R?21"}.

%% Tell rebar about this directory's structure
{lib_dirs, ["apps", "deps"]}.
{sub_dirs, ["apps/*"]}.

%% Build a release when compiling
%%{post_hooks,[{compile, "./relx"}]}.

%% The release ships a PREBUILT sbutt.escript (see the overlay below), so
%% build it from the source before every release and tar, in every profile.
%% Likewise the plugins it ships: scripts/stage-plugins.sh builds each one
%% named in $PLUGINS (the Makefile's ../ssb_git) into _build/plugins.
{pre_hooks, [{release, "escript scripts/build-sbutt.escript sbutt.escript _build/sbutt/sbutt.escript"},
             {release, "scripts/stage-plugins.sh"},
             {tar,     "escript scripts/build-sbutt.escript sbutt.escript _build/sbutt/sbutt.escript"},
             {tar,     "scripts/stage-plugins.sh"}]}.

%% These deps are temporary forks, that needed minor tweaks to make usable,
%% or are not actively maintained
%% TODO: push changes upstream or otherwise resolve
{deps, [
    {ranch, "2.1.0", {git, "https://github.com/ninenines/ranch", {tag, "2.1.0"}}},
    {enacl, "1.1.1", {git, "https://github.com/cmoid/enacl", {branch, "moid-v1.1.1"}}},
    %% Embedded store for derived state (doc/persistence.md §6).  A NIF
    %% that bundles the SQLite amalgamation, so there is no system
    %% dependency; it runs its blocking work on dirty schedulers.  Note it
    %% compiles with SQLITE_DQS=0 — double-quoted string literals are a
    %% syntax error, single quotes only.
    %%
    %% Forked rather than taken from hex, for the same reason as enacl.
    %% The hex release 0.9.0 exists at no commit in mmzeeman/esqlite — its
    %% app.src version was bumped only in the published tarball, and the
    %% newest tag there is 0.8.8 — so there was no revision to audit or
    %% return to.  This fork is upstream master (5c8d590, post-0.9.0) with
    %% the version set honestly; that also picks up the fix replacing a
    %% fixed 512-byte filename buffer in esqlite_open with a growing one.
    %% The bundled SQLite amalgamation was diffed against upstream and is
    %% byte-identical (3.50.4).
    {esqlite, "0.9.1",
     {git, "https://github.com/cmoid/esqlite", {tag, "moid-v0.9.1"}}}
]}.
{ct_opts, [{sname, erlbutt_ct},
           {dir, ["apps/ssb/test", "apps/plumtree/test", "apps/silkpurse/test"]}]}.
%% Base release = the app list for `make rel`.  A profile that gives its own
%% {release, ...} tuple REPLACES this list (verified: prod's .rel has no
%% compiler), so devpkg and prod each enumerate their full set.  syntax_tools
%% + tools are here because distel/maxbutt need them on the node path for the
%% local `make rel` workflow, and tools (fprof/eprof/xref) is useful for
%% remsh-time profiling of a prod node.  The GUI stack (debugger, observer,
%% wx) is NOT here — devpkg adds it.
%%
%% compiler stays in the dev releases for in-node compiling from distel.  It
%% is no longer needed by the CLI: the release ships sbutt.escript PREBUILT
%% (scripts/build-sbutt.escript, run by the pre_hooks above), so prod
%% leaves it out.
{relx, [{release, { ssb, {git, short} },
         [ssb,
          esqlite,
          ssb_conv,
          admin,
          plumtree,
          silkpurse,
          compiler,
          runtime_tools,
          syntax_tools,
          tools]},

        {sys_config_src, "./config/sys.config.src"},
        {vm_args_src, "./config/vm.args.src"},

        {extended_start_script, true},
        %% Ensures $HOME/.erlang.cookie exists (or matches SSB_COOKIE)
        %% before the node starts.  A no-op when vm.args sets its own
        %% cookie, so only prod (vm.args.prod has none) is affected.
        {extended_start_script_hooks,
         [{pre_start, [{custom, "hooks/cookie.sh"}]}]},

        {overlay_vars, "config/default.vars"},
        %% sbutt.escript ships INSIDE the release, at the root, because
        %% `bin/ssb escript` resolves its argument against $ROOTDIR — so a
        %% copy living anywhere else cannot be run that way.  Shipping it
        %% here means a deploy is "extract the tarball" with no follow-up
        %% step to forget, and the CLI can never be a different vintage
        %% than the node it is talking to.
        %% bin/sbutt is the launcher; symlink it onto PATH.  sbutt.escript
        %% is the prebuilt beam escript, still at the release root so the
        %% older `bin/ssb escript sbutt.escript` form keeps working.
        {overlay, [
                   {template, "config/ssb.cfg", "ssb.cfg"},
                   {copy, "_build/sbutt/sbutt.escript", "sbutt.escript"},
                   {copy, "config/sbutt", "bin/sbutt"},
                   {copy, "config/install-service", "bin/install-service"},
                   %% the pub's /usr/local/bin wrappers, which
                   %% install-service --system installs from here
                   {copy, "doc/ops/sbutt", "share/ops/sbutt"},
                   {copy, "doc/ops/sbutt-console", "share/ops/sbutt-console"},
                   {copy, "config/hooks/cookie.sh", "bin/hooks/cookie.sh"},
                   %% Plugins are NOT in the release tuples above: they are
                   %% found on disk and started by plugin_loader, so that
                   %% {plugins, []} in ssb.cfg leaves them out and one can be
                   %% dropped into <data>/plugins without a rebuild.
                   {copy, "_build/plugins", "plugins"}
                  ]}

]
}.

{profiles, [%% Fast local iteration: symlinked beams, system-installed ERTS.
            {dev, [{plugins, [rebar3_auto]},
                   {erl_opts, [debug_info]},
                   {relx, [{dev_mode, true},
                            {include_erts, false}]}]
            },
            %% Distributable developer package: bundled ERTS, debug-instrumented
            %% beams, source code, and the GUI stack for live development with
            %% maxbutt.  A profile's release tuple REPLACES the base app list
            %% (it does not union), so this must enumerate the full set: the
            %% base apps plus debugger + observer.
            {devpkg, [{erl_opts, [debug_info]},
                      {relx, [{release, {ssb, {git, short}},
                               [ssb, esqlite, ssb_conv, admin, plumtree, silkpurse,
                                compiler, runtime_tools, syntax_tools, tools,
                                debugger, observer]},
                              {vm_args_src, "./config/vm.args.devpkg"},
                              {dev_mode, false},
                              {include_erts, true},
                              {include_src, true},
                              {debug_info, keep}]}]
            },
            %% Production package: bundled ERTS, stripped beams, no source, no
            %% GUI stack, no compiler.  Its own release tuple, which replaces
            %% the base list rather than adding to it.
            %%
            %% overlay_vars is a LIST here: default.vars supplies every variable
            %% ssb.cfg needs, prod.vars then overrides just network_id with the
            %% real network.  Every other build — make rel, devpkg, eunit, ct —
            %% keeps ?DEFAULT_NETWORK_ID's almost-mainnet id, so reaching the
            %% real network is something you have to ask for by name.
            {prod, [{erl_opts, [no_debug_info, warnings_as_errors]},
                    {relx, [{release, {ssb, {git, short}},
                             [ssb, esqlite, ssb_conv, admin, plumtree, silkpurse,
                              runtime_tools, syntax_tools, tools]},
                            {vm_args_src, "./config/vm.args.prod"},
                            {overlay_vars, ["config/default.vars",
                                            "config/prod.vars"]},
                            {dev_mode, false},
                            {include_erts, true},
                            {include_src, false},
                            {debug_info, strip}]}]
            }]
}.
