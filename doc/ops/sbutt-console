# sbutt-console — attach an Erlang shell to the erlbutt node on this host.
#
#   sbutt-console
#
# Install:
#   sudo install -m 0755 doc/ops/sbutt-console /usr/local/bin/sbutt-console
#
# Companion to `sbutt`, and it exists for the same reason: `bin/ssb` needs
# the environment systemd gives it, and getting that wrong is worse here
# than it looks.
#
# remote_console reads the cookie from $HOME/.erlang.cookie, so it has to
# run as the service account with the service account's HOME (sudo -H):
# that is the file the node itself uses.  And because vm.args.src exists,
# EVERY bin/ssb invocation re-expands vm.args from the current environment;
# sourcing the same EnvironmentFile the unit uses (when there is one) keeps
# the node name and port identical to what systemd started.
#
# The env file, if any, is root:erlbutt 0640, so the service account reads
# it itself — nothing secret passes through this script's arguments.
set -eu

# Refresh the sudo timestamp as its own step, before the console takes over
# the terminal, so the password prompt cannot be confused with the shell
# failing to attach.
sudo -v -p "sbutt-console: sudo password for %p: " || exit 1

# The one that costs you a pub.  `q().` is evaluated on the REMOTE node —
# it is init:stop() and it shuts the thing down.  Ctrl-G q quits only the
# local shell job; Ctrl-C twice aborts the hidden remsh node, not the pub.
printf 'sbutt-console: leave with Ctrl-G then q. Do NOT type q(). — it stops the node.\n' >&2

exec sudo -H -u erlbutt sh -c '
    set -a
    if [ -r /etc/erlbutt/env ]; then . /etc/erlbutt/env; fi
    set +a
    # Defaults mirror the systemd unit and vm.args.prod.  Anything defined
    # in /etc/erlbutt/env wins, so moving those settings out of the unit
    # and into the env file makes this agree automatically.
    : "${SSB_HOME:=/opt/erlbutt}"
    : "${SSB_NODE:=ssb@127.0.0.1}"
    : "${SSB_DIST_PORT:=9100}"
    export SSB_HOME SSB_NODE SSB_DIST_PORT
    exec "$SSB_HOME/bin/ssb" remote_console "$@"
' sbutt-console "$@"
