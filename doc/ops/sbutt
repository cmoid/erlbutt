#
# sbutt — run the erlbutt CLI against the node on this host.
#
#   sbutt whoami
#   sbutt health
#   sbutt get %somekey=.sha256
#
# Install once:
#   sudo install -m 0755 doc/ops/sbutt /usr/local/bin/sbutt
#
# sbutt.escript itself needs no installing — a relx overlay ships it at the
# release root, so extracting the tarball puts it where `bin/ssb escript`
# looks and the CLI is always the same vintage as the node.
#
# Three things this exists to get right, all of them easy to forget:
#
#  1. It runs as the SERVICE account.  .ssberl/secret is mode 600 owned by
#     erlbutt, and keys:start_link/0 reads it, so every command that opens
#     a connection fails as anyone else.  (`census encoding` is the lone
#     exception — it folds the logs directly and needs no keys.)
#
#  2. It supplies the same environment systemd does.  Because vm.args.src
#     exists, EVERY bin/ssb invocation re-expands vm.args from the current
#     environment, so a different SSB_NODE or SSB_DIST_PORT would leave
#     the node's args wrong on disk.  Sourcing the same EnvironmentFile
#     the unit uses (when there is one) keeps the two from drifting.  -H
#     makes HOME the service account's, which is where the node's
#     .erlang.cookie lives.
#
#  3. It goes through `bin/ssb escript` rather than a system escript, so
#     it uses the ERTS bundled in the release.  Nothing needs to be on
#     PATH and it survives an OTP upgrade.  The script path is relative to
#     the release root on purpose: relx_escript prepends $ROOTDIR.
#
# The env file, if any, is root:erlbutt 0640, so the service account reads
# it itself — nothing secret passes through this script's arguments.
set -eu

# Refresh the sudo timestamp FIRST, as its own step.  Otherwise the password
# prompt lands in the middle of a pipeline — `sbutt hist ... | jq .` starts
# jq immediately, which blocks reading an empty pipe while sudo waits on the
# tty, and the whole thing reads as a hang rather than a prompt.  Doing it
# here means the prompt appears before any data moves, clearly labelled.
sudo -v -p "sbutt: sudo password for %p: " || exit 1

exec sudo -H -u erlbutt sh -c '
    set -a
    if [ -r /etc/erlbutt/env ]; then . /etc/erlbutt/env; fi
    set +a
    : "${SSB_HOME:=/opt/erlbutt}"
    export SSB_HOME
    exec "$SSB_HOME/bin/ssb" escript sbutt.escript "$@"
' sbutt "$@"
